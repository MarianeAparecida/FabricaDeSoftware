# Copie para .env.smtp (fica fora do git) e rode `npm run smtp:configurar`.
# Veja docs/envio-de-email.md.

# Personal Access Token do Supabase (https://supabase.com/dashboard/account/tokens).
# As chaves anon/service_role/sb_secret NÃO servem: elas não acessam a Management API.
SUPABASE_ACCESS_TOKEN=
# Projeto da nuvem do AgendaSUS.
SUPABASE_PROJECT_REF=szbcloiswybqiwyyejdj

# Servidor SMTP. Enquanto o AgendaSUS não tem domínio próprio, usamos a caixa do SetupBarato (Hostinger).
SMTP_HOST=smtp.hostinger.com
# 465 = SSL direto; 587 = STARTTLS. O Supabase aceita os dois.
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente (From). Na Hostinger precisa ser a própria caixa autenticada ou um alias dela.
# Se vazio, usa SMTP_USER.
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=AgendaSUS
# Máximo de e-mails do Auth por hora no projeto.
SMTP_LIMITE_POR_HORA=30
